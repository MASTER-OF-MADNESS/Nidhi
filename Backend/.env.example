# ---------------------------------------------------------------------------
# NIDHI backend configuration
# Copy this file to .env and fill in the two API keys.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- REQUIRED: fill these in ---
GEMINI_API_KEY=your_gemini_key_here
TAVILY_API_KEY=your_tavily_key_here

# --- Login (single hardcoded credential) ---
# The frontend login form posts these values to POST /auth/login.
#
# WARNING: these defaults are published in the repository and prefilled on the
# login screen for demo convenience. They are NOT a secret. Change
# NIDHI_PASSWORD in your local .env before exposing this app on any network
# beyond localhost.
NIDHI_USERNAME=temenos_admin
NIDHI_PASSWORD=temenos@nidhi2026
COMPANY_ID=temenos

# --- Model / retrieval ---
# Model must be one your key is provisioned for. gemini-1.5-flash and
# gemini-2.5-flash are closed to new keys.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=60
TAVILY_TIMEOUT=8
MAX_TAVILY_RESULTS=10
TAVILY_MIN_NGOS=3

# --- Paths ---
MD_DATA_PATH=./data/
SQLITE_DB_PATH=./db/nidhi.db

# --- Behaviour ---
STREAMING_ENABLED=true
ALLOCATION_UNIT=1000
REGION_CAP=0.40
SECTOR_CAP=0.40
MIN_WOMEN_SHARE=0.15
MIN_ENVIRONMENT_SHARE=0.15
FX_USD_TO_INR=83.0
